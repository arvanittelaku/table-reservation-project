# ONE env file for the whole project: backend (Django), web app (Vite) and the server (docker).
#   cp .env.example .env        (never commit .env; on the server also: chmod 600 .env)
# Local: the values below work as they are, fill in only JWT_SECRET and the database.
# Server: the "PRODUCTION" lines at the end of each section say what to put instead.
# Do not put quotes around values (docker reads this file too), except JAAS_PRIVATE_KEY.
# Variables starting with VITE_ end up in the public web app: no secrets there.

# ───────── Backend (Django) ─────────
# PRODUCTION: 0
DEBUG=1
# PRODUCTION: long random value
DJANGO_SECRET_KEY=change-me
# Signs login tokens. Long random value in production; changing it signs everyone out.
JWT_SECRET=
# PRODUCTION: api.ejabashkohu.com
ALLOWED_HOSTS=

# Postgres: the existing database (local dev copy, or Supabase's database).
# Supabase: Project Settings -> Database -> connection string, "Session pooler" (works over IPv4):
# host aws-…-eu-west-1.pooler.supabase.com, port 5432, user postgres.<project-ref>.
# Not the transaction pooler (6543).
# PRODUCTION: postgres
DB_NAME=ejb_dev
# PRODUCTION: postgres.<project-ref>
DB_USER=postgres
DB_PASSWORD=
# PRODUCTION: the pooler host
DB_HOST=/tmp
# PRODUCTION: 5432
DB_PORT=54329
# PRODUCTION: require
DB_SSLMODE=prefer

# on the server docker sets this itself
REDIS_URL=redis://127.0.0.1:6379/0

# Where the web app lives and where this backend is reachable.
# PRODUCTION: https://ejabashkohu.com
SITE_URL=http://localhost:5173
# PRODUCTION: https://api.ejabashkohu.com
API_URL=http://localhost:8000
# PRODUCTION: https://ejabashkohu.com,https://www.ejabashkohu.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
# PRODUCTION: same as CORS_ALLOWED_ORIGINS
AUTH_REDIRECT_ALLOWLIST=http://localhost:5173
# Django admin at <API_URL>/django-admin/ (app admins sign in with their app password)
# CSRF_TRUSTED_ORIGINS=https://api.ejabashkohu.com
# ADMIN_SESSION_AGE=28800

# Require email confirmation before first sign-in (Supabase default)
AUTH_EMAIL_CONFIRM=1

# Email: console locally; SMTP in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# PRODUCTION: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend, then:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ejaBashkohu <support@ejabashkohu.com>

# Google sign-in (Google Cloud Console -> OAuth client, redirect URI: <API_URL>/auth/v1/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple sign-in (Services ID, Team ID, Key ID and the .p8 key with \n for newlines)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ───────── Profile photos ─────────
# local = a folder (default; on the server the docker volume), or S3-compatible storage:
# Cloudflare R2 (dashboard -> R2 -> private bucket "ejabashkohu-avatars" -> Manage R2 API tokens ->
# Object Read & Write) or Hetzner Object Storage (Console -> Object Storage -> bucket + credentials).
STORAGE_BACKEND=local
# STORAGE_ROOT=/data/storage
# STATIC_ROOT=/static               # collectstatic target (served by Caddy in deploy/)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # Hetzner: https://fsn1.your-objectstorage.com
# S3_BUCKET=ejabashkohu-avatars
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto                    # R2: auto; Hetzner: fsn1 / nbg1 / hel1
# S3_KEY_PREFIX=                    # optional, e.g. dev/ to share one bucket
# S3_SIGNED_URL_MODE=presigned      # presigned (browser loads from the bucket), redirect or proxy
# S3_PRESIGN_TTL=3600

# ───────── Video lessons ─────────
# VIDEO_PROVIDER: jaas | jitsi | public; empty = auto (jitsi when JITSI_APP_SECRET set, jaas when
# JAAS_* set, else public). public = open rooms without tokens (meet.jit.si ends embedded calls
# after 5 minutes: local tests only). PRODUCTION: jaas or jitsi (see deploy/README.md).
VIDEO_PROVIDER=
# own Jitsi: meet.ejabashkohu.com
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=ejabashkohu
# own Jitsi: openssl rand -hex 32 (signs room tokens)
JITSI_APP_SECRET=
# JaaS (jaas.8x8.vc -> API Keys). Private key: whole PEM in double quotes on one line, \n for newlines:
#   JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv…\n-----END PRIVATE KEY-----"
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=
# JAAS_PRIVATE_KEY_FILE=/run/secrets/jaas.pk
# JAAS_DOMAIN=8x8.vc
# Own Jitsi server (deploy/jitsi/, separate machine): extra values read from this same file
# JITSI_PUBLIC_IP=                        # that server's public IPv4
# LETSENCRYPT_EMAIL=
# JICOFO_AUTH_PASSWORD=                   # openssl rand -hex 16
# JVB_AUTH_PASSWORD=                      # openssl rand -hex 16
# JITSI_TZ=Europe/Belgrade

# ───────── Web app (Vite) ─────────
# URL of the Django backend. Local: python manage.py serve. Cloudflare Pages: set the same
# VITE_ variables under Settings -> Environment variables (the build does not see this file).
# PRODUCTION: https://api.ejabashkohu.com
VITE_API_URL=http://localhost:8000
VITE_JITSI_DOMAIN=
VITE_JITSI_ROOM_PREFIX=
# WhatsApp support button (international format, e.g. 38344123456). Empty = button hidden.
VITE_SUPPORT_WHATSAPP=

# ───────── Server only (deploy/) ─────────
# domain Caddy gets the HTTPS certificate for
API_DOMAIN=api.ejabashkohu.com
# 1: backup.sh also uploads the dump to the bucket
BACKUP_S3=0
BACKUP_KEEP_DAYS=14
