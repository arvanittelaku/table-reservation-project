# Copy to backend/.env for local development (never commit the real .env).

DEBUG=1
DJANGO_SECRET_KEY=change-me
# Signs login tokens. Long random value in production; changing it signs everyone out.
JWT_SECRET=

# Postgres: the existing database (local dev copy, or Supabase's database).
# Supabase: Project Settings -> Database -> connection string ("direct" or
# "session pooler"; not the transaction pooler). User must be `postgres`.
DB_NAME=ejb_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=/tmp
DB_PORT=54329
DB_SSLMODE=prefer

REDIS_URL=redis://127.0.0.1:6379/0

# Where the web app lives and where this backend is reachable.
SITE_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_REDIRECT_ALLOWLIST=http://localhost:5173

# Require email confirmation before first sign-in (Supabase default)
AUTH_EMAIL_CONFIRM=1

# Email: console locally; SMTP in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ejaBashkohu <support@ejabashkohu.com>

# Uploaded files (avatars): local folder (default) or S3-compatible object storage.
STORAGE_BACKEND=local
# STORAGE_ROOT=/data/storage
# STATIC_ROOT=/static               # where collectstatic puts the Django admin CSS/JS (served by Caddy in deploy/)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # Hetzner: https://fsn1.your-objectstorage.com
# S3_BUCKET=ejabashkohu-avatars
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto                     # R2: auto; Hetzner: fsn1 / nbg1 / hel1
# S3_KEY_PREFIX=                     # optional, e.g. dev/ to share one bucket
# S3_SIGNED_URL_MODE=presigned       # presigned (bucket URL), redirect (API URL -> presigned) or proxy (stream through the API)
# S3_PRESIGN_TTL=3600

# Video lessons. VIDEO_PROVIDER: jaas | jitsi | public; empty = auto (jitsi when
# JITSI_APP_SECRET set, jaas when JAAS_* set, else public). public = open rooms on
# JITSI_DOMAIN without tokens (meet.jit.si ends embedded calls after 5 minutes: local tests only).
VIDEO_PROVIDER=
JITSI_DOMAIN=meet.jit.si
# VIDEO_PROVIDER=jitsi: own Jitsi with JWT auth (deploy/jitsi/), HS256 secret = its JWT_APP_SECRET
JITSI_APP_ID=ejabashkohu
JITSI_APP_SECRET=
# VIDEO_PROVIDER=jaas: 8x8 JaaS (jaas.8x8.vc -> API Keys). Private key PEM with \n escapes
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=
# JAAS_PRIVATE_KEY_FILE=/run/secrets/jaas.pk
# JAAS_DOMAIN=8x8.vc

# Django admin at <API_URL>/django-admin/ (app admins sign in with their app password)
# CSRF_TRUSTED_ORIGINS=http://localhost:8000
# ADMIN_SESSION_AGE=28800

# Google sign-in (Google Cloud Console -> OAuth client, redirect URI: <API_URL>/auth/v1/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in (Services ID, Team ID, Key ID and the .p8 key with \n for newlines)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
