{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "types": [
      "vite/client"
    ],
    "allowJs": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/types/react-shim.d.ts",
    "src/types/vendor-shim.d.ts"
  ]
}
