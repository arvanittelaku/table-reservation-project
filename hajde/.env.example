# Copy to .env in this directory (hajde/) before running locally.
# URL of the Django backend (../backend). Local: python manage.py serve
VITE_API_URL=http://localhost:8000

# Lesson video (Jitsi). meet.jit.si limits embedded calls to a short demo;
# for production use JaaS (8x8.vc + your vpaas-magic-cookie-.../ prefix) or your own Jitsi server.
VITE_JITSI_DOMAIN=
VITE_JITSI_ROOM_PREFIX=

# WhatsApp support button (international format, e.g. 38344123456). Empty = button hidden.
VITE_SUPPORT_WHATSAPP=
