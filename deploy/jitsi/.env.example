# deploy/jitsi/.env  (cp .env.example .env; chmod 600 .env)
# JITSI_DOMAIN, JITSI_APP_ID and JITSI_APP_SECRET must equal the backend's values in
# deploy/.env.production, where VIDEO_PROVIDER=jitsi.
JITSI_DOMAIN=meet.ejabashkohu.com
JITSI_APP_ID=ejabashkohu
JITSI_APP_SECRET=             # openssl rand -hex 32  (HS256, signs room tokens)
JITSI_PUBLIC_IP=              # this server's public IPv4 (JVB advertises it for media)
LETSENCRYPT_EMAIL=            # for the HTTPS certificate of JITSI_DOMAIN
JICOFO_AUTH_PASSWORD=         # openssl rand -hex 16
JVB_AUTH_PASSWORD=            # openssl rand -hex 16
JITSI_TZ=Europe/Belgrade
# JITSI_IMAGE_VERSION=stable-10532-1
