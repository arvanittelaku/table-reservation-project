# Copy to deploy/.env.production on the server (never commit it). chmod 600.
DEBUG=0
DJANGO_SECRET_KEY=            # python3 -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SECRET=                   # same command, a different value
ALLOWED_HOSTS=api.ejabashkohu.com

# Supabase database: Project Settings -> Database -> Connection string.
# Use the "Session pooler" (works over IPv4): host aws-…-eu-west-1.pooler.supabase.com,
# port 5432, user postgres.<project-ref>. Not the transaction pooler (6543).
DB_NAME=postgres
DB_USER=postgres.upxxfhvgbmddhyebaiug
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

SITE_URL=https://ejabashkohu.com
API_URL=https://api.ejabashkohu.com
CORS_ALLOWED_ORIGINS=https://ejabashkohu.com,https://www.ejabashkohu.com
AUTH_REDIRECT_ALLOWLIST=https://ejabashkohu.com,https://www.ejabashkohu.com
AUTH_EMAIL_CONFIRM=1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ejaBashkohu <support@ejabashkohu.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Profile photos. local = the `storage` volume (default). s3 = an S3-compatible bucket:
# Cloudflare R2 (dashboard -> R2 -> create bucket "ejabashkohu-avatars", private;
# "Manage R2 API tokens" -> Object Read & Write for that bucket -> Access Key ID + Secret),
# or Hetzner Object Storage (Console -> Object Storage -> bucket + S3 credentials).
STORAGE_BACKEND=local
S3_ENDPOINT=              # R2: https://<account-id>.r2.cloudflarestorage.com  Hetzner: https://fsn1.your-objectstorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto                # R2: auto; Hetzner: fsn1 / nbg1 / hel1
S3_KEY_PREFIX=
BACKUP_S3=0                   # 1: backup.sh also uploads the dump to the bucket (backups/)
BACKUP_KEEP_DAYS=14
S3_SIGNED_URL_MODE=presigned  # presigned (browser loads from the bucket), redirect (API URL -> bucket) or proxy (through the API)

# Video lessons (deploy/README.md "Video lessons"). Pick ONE provider:
#   VIDEO_PROVIDER=jaas   8x8 Jitsi as a Service, simplest (jaas.8x8.vc)
#   VIDEO_PROVIDER=jitsi  own Jitsi server from deploy/jitsi/ (VPS 4 GB+, UDP 10000 open)
VIDEO_PROVIDER=jaas
# JaaS: console -> API Keys -> "Add API key" -> download the private key. App ID =
# vpaas-magic-cookie-…; API key id = the kid shown next to the key ("vpaas-magic-cookie-…/abc123",
# the short "abc123" works too). Private key: the whole PEM in double quotes on one line, \n for newlines:
#   JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv…\n-----END PRIVATE KEY-----"
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=
# Own Jitsi (VIDEO_PROVIDER=jitsi): the same values go into deploy/jitsi/.env (see .env.example there).
JITSI_DOMAIN=meet.ejabashkohu.com
JITSI_APP_ID=ejabashkohu
JITSI_APP_SECRET=             # openssl rand -hex 32  (signs room tokens, backend + prosody)

# Django admin (https://api.ejabashkohu.com/django-admin/, app admins only)
CSRF_TRUSTED_ORIGINS=https://api.ejabashkohu.com
